# Variables consumed by docker-compose.yml itself (docker-compose reads a
# file named exactly `.env` in the same directory as docker-compose.yml).
# Copy this to `.env` at the project root and adjust for your deployment.
# Application-level config (email, M-Pesa, Firebase, Maps, JWT secrets, etc.)
# still lives in backend/.env — see backend/.env.example.

# Postgres superuser password (used by both the db and backend services)
POSTGRES_PASSWORD=change-me-in-production

# Comma-separated hostnames/IPs this deployment will be served from
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Host port the web (nginx) container binds to
WEB_PORT=80
