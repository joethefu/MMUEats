# ==== Core ====
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==== Database ====
# Leave blank during local dev to fall back to SQLite.
# Production example: postgres://USER:PASSWORD@HOST:5432/mmueats
DATABASE_URL=

# ==== CORS ====
CSRF_TRUSTED_ORIGINS=
# Production: set CELERY_TASK_ALWAYS_EAGER=True to run emails/notifications inline (no worker needed)
CELERY_TASK_ALWAYS_EAGER=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==== JWT ====
JWT_SECRET=change-me-too
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# ==== Email (noreply Gmail account for verification / password reset) ====
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MMUEats <noreply@mmueats.com>
FRONTEND_URL=http://localhost:5173

# ==== M-Pesa Daraja API ====
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback/

# ==== Firebase Cloud Messaging ====
FIREBASE_CONFIG=

# ==== Google Maps ====
GOOGLE_MAPS_API_KEY=

# ==== Redis / Celery ====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
